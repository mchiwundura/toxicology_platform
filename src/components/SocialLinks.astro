---
import { SOCIAL_LINKS } from '../consts';

interface Props {
	class?: string;
	hideOnMobile?: boolean;
}

const { class: className, hideOnMobile = false } = Astro.props;
---

<div class:list={['social-links', className, { 'hide-on-mobile': hideOnMobile }]}>
	{SOCIAL_LINKS.map(({ name, href, icon }) => (
		<a href={href} target="_blank" rel="noopener noreferrer">
			<span class="sr-only">Follow DATIS on {name}</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32">
				<path fill="currentColor" d={icon} />
			</svg>
		</a>
	))}
</div>

<style>
	.social-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1em;
	}
	.social-links a {
		display: flex;
		padding: 0;
		border-bottom: none;
		color: inherit;
		text-decoration: none;
	}
	.social-links a:hover {
		color: var(--accent);
	}
	.social-links svg {
		width: 1.5rem;
		height: 1.5rem;
	}
	@media (max-width: 720px) {
		.social-links.hide-on-mobile {
			display: none;
		}
	}
</style>
